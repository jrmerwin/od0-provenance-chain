  "per_gate_table": {
    "ALL": {
      "C1": "deadlock-free from genesis",
      "C2": "TG1 baseline; leaf fraction 1/3 (measured 0.33331-0.33366 at n = 2e5)",
      "C3": "rho = 8 exactly (frozen R63); all D1 structures as R63",
      "C4": "SMALL_WORLD",
